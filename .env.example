# Database — Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?schema=public"

# NextAuth.js
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
